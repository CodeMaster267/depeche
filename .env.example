# Copy to .env.local for local development. Never commit real values.
# In production these live in Vercel: Project → Settings → Environment Variables.

# From Supabase: Project Settings → API. The anon key is safe in the browser;
# row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_. Bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
