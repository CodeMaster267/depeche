# For local development, `npm run db:start` writes .env.local for you. Never commit real values.
# In production these live in Vercel: Project → Settings → Environment Variables.

# From Supabase: Project Settings → API Keys. The publishable (anon) key is safe in the browser;
# row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: the secret (service_role) key. Never prefix with NEXT_PUBLIC_. Bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# The owner's email address. Only this address can set Depeche up the first time (at /setup).
DEPECHE_OWNER_EMAIL=
